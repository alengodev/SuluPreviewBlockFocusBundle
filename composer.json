{
    "name": "alengo/sulu-preview-block-focus-bundle",
    "type": "symfony-bundle",
    "description": "Sulu CMS admin enhancement: clicking a block in the preview iframe scrolls to and expands the corresponding block in the admin form.",
    "keywords": ["sulu", "cms", "preview", "block", "focus", "admin"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sulu/sulu": "^3.0",
        "symfony/framework-bundle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Alengo\\SuluPreviewBlockFocusBundle\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "symfony": {
            "allow-contrib": false,
            "require": "^7.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
